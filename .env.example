# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
# For a managed provider (e.g. Supabase), use the host/port/user/password
# from your project's connection string and set DB_SSL=true.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=pawaacflow
DB_PASSWORD=pawaacflow_secret
DB_DATABASE=pawaacflow
# Set to true for managed Postgres providers that require TLS (Supabase, RDS, etc.)
DB_SSL=false
# Set to false only if the provider presents a cert not in Node's CA store
# (e.g. some Supabase pooler endpoints). Has no effect unless DB_SSL=true.
DB_SSL_REJECT_UNAUTHORIZED=true
# Max connections in the TypeORM/pg pool
DB_POOL_SIZE=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OpenWA (WhatsApp Gateway)
# Set OPENWA_ENABLED=true to mount the WhatsApp module (linking, verification,
# digest, inbound webhook). Leave unset/false to run without WhatsApp.
OPENWA_ENABLED=false
OPENWA_API_URL=http://openwa:8080
OPENWA_API_KEY=your-openwa-api-key
OPENWA_WEBHOOK_SECRET=your-webhook-secret

# LLM Configuration (for AI-powered WhatsApp message parsing)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PawaacFlow <noreply@example.com>

# Redis (for WebSocket scaling, optional)
REDIS_HOST=redis
REDIS_PORT=6379
