# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=pawaacflow
DB_PASSWORD=pawaacflow_secret
DB_DATABASE=pawaacflow

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OpenWA (WhatsApp Gateway)
# Set OPENWA_ENABLED=true to mount the WhatsApp module (linking, verification,
# digest, inbound webhook). Leave unset/false to run without WhatsApp.
OPENWA_ENABLED=false
OPENWA_API_URL=http://openwa:8080
OPENWA_API_KEY=your-openwa-api-key
OPENWA_WEBHOOK_SECRET=your-webhook-secret

# LLM Configuration (for AI-powered WhatsApp message parsing)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PawaacFlow <noreply@example.com>

# Redis (for WebSocket scaling, optional)
REDIS_HOST=redis
REDIS_PORT=6379
